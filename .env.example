# Copy to .env.local (git-ignored) and restart `npx expo start`.
# Gateway origin, no trailing slash. No default on purpose (see src/lib/config.ts).
# The project develops and tests against production.
EXPO_PUBLIC_API_URL=https://api.jwetlakay.com

# Odds WebSocket (spec Phần C §0.4). Optional: unset = live odds stay off.
EXPO_PUBLIC_ODDS_WS_URL=wss://api.jwetlakay.com/ws

# ---- [WEB-PARITY] client-side signing, same variables as the web (VITE_* -> EXPO_PUBLIC_*) ----
# WARNING: EXPO_PUBLIC_* values are compiled into the app and can be extracted from it, exactly
# like the web's VITE_* values. Chosen deliberately to match web mobile mode; see src/lib/config.ts.
# Put real values only in .env.local (git-ignored), never in this file.

# Sport-api REST signature for /core-read/v1/web/** (web VITE_SPORT_API_*).
# Empty secret = requests go out unsigned (web dev mode). Client id defaults to "web-app".
EXPO_PUBLIC_SPORT_API_CLIENT_ID=web-app
EXPO_PUBLIC_SPORT_API_SECRET=

# Socket handshake (web VITE_SOCKET_*). Production fetches the signature from the endpoint and
# leaves the secret EMPTY; the secret is only a fallback for testing (shared by web/ios/android).
EXPO_PUBLIC_SOCKET_SIGNATURE_URL=/core-read/v1/web/socket-signature
EXPO_PUBLIC_SOCKET_CLIENT_ID=web-prod
EXPO_PUBLIC_SOCKET_SECRET=

# Lottery ticket purchase signature (web VITE_LOTTERY_ACCESS_KEY / VITE_LOTTERY_SECRET_KEY).
EXPO_PUBLIC_LOTTERY_ACCESS_KEY=
EXPO_PUBLIC_LOTTERY_SECRET_KEY=

# Images: not needed. The web declares VITE_IMAGE_URL_PREFIX but renders the image URLs the API
# returns as-is (its prefix helper has no caller); the app does the same.

# Dev-only Lucky Spin preview with sample data (no server calls), ignored in release builds:
#   guest  → guest wheel when logged out      member → signed-in wheel even when logged out
# Leave empty to use the real API.
EXPO_PUBLIC_LUCKY_SPIN_PREVIEW=
